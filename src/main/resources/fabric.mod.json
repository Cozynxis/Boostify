{
  "schemaVersion": 1,
  "id": "boostify",
  "version": "${version}",
  "name": "Boostify",
  "description": "A safe/balanced client-side performance mod for Minecraft 26.2 focused on FPS, frametime stability and lower render workload.",
  "authors": ["Cozynxis"],
  "license": "MIT",
  "icon": "assets/boostify/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.cozynxis.boostify.client.BoostifyClient"
    ],
    "modmenu": [
      "dev.cozynxis.boostify.client.compat.BoostifyModMenuApi"
    ]
  },
  "mixins": [
    {
      "config": "boostify.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*",
    "lithium": "*"
  }
}
